<?xml version="1.0" encoding="utf-8"?>
<!-- Classic TouchWiz music widget: album art on the left, title/artist and controls on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tw_w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/widget_art_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Album art"
            android:scaleType="centerCrop"
            android:src="@drawable/tw_default_art_large" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Music Player"
            android:textColor="#FFF0F0F0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Tap to play"
            android:textColor="#FF96CFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_shuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Shuffle"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/tw_w_shuffle_off" />

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Previous"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/w_btn_prev" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:background="@null"
                android:contentDescription="Play"
                android:scaleType="fitCenter"
                android:src="@drawable/w_btn_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Next"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:src="@drawable/w_btn_next" />

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:contentDescription="Repeat"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/tw_w_repeat_off" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
